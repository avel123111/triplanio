# Vercel CLI local (pulled env / project link)
.vercel

# Граф кода (команда /graph). Собирается за ~10 c в каждой сессии заново и
# НЕ коммитится: 3 МБ на каждый PR + конфликты, а главное — устаревшая карта
# хуже отсутствующей, ей поверят. Что не индексируется — в .graphifyignore.
graphify-out/

# Playwright MCP artefacts. Snapshots and console logs идут в --output-dir,
# а вот скриншот с относительным filename сервер кладёт относительно КОРНЯ
# воркспейса, то есть в корень репо. Вторая строка - сетка безопасности на этот
# случай: картинок в корне у нас нет, всё лежит в public/.
.playwright-mcp/
/*.png
/*.jpg
/*.jpeg

# Лок-файл Deno. Появляется, если гонять `deno check`/`deno test` по
# `supabase/functions/**` локально, но в репозитории ему делать нечего: CI зовёт
# Deno с ЯВНЫМ `--no-lock` (см. джобу `deno` в checks.yml), то есть закоммиченный
# лок не читал бы никто, а расходиться с реальностью он умеет.
deno.lock
