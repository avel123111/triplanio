{
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/:dir(auth|covers|flags|fonts|hero|partners|site)/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:file(og-cover.jpg|og-join.jpg|icon-192.png|icon-512.png|apple-touch-icon.png|favicon.ico|triplanio-logo.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/:seg(public|join)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/d/spain-may-27",
      "destination": "/d/europe-may-2027",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/array/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path"
    },
    {
      "source": "/api/:path(.*)",
      "destination": "/api/proxy?path=:path"
    },
    {
      "//": "SPA-фолбэк: сервер не знает про /trips, /trip/:id и прочие маршруты — их рисует роутер, поэтому неизвестный адрес отдаёт index.html.",
      "//assets": "assets/ ИСКЛЮЧЕНЫ намеренно (TRIP-284). Имя чанка хешировано содержимым, и после деплоя старая вкладка просит файл, которого уже нет. Под общим правилом такой запрос получал 200 и тело index.html: браузер падал на «Failed to fetch dynamically imported module» (HTML вместо модуля), в мониторинге это неотличимо от лежащей сети, а заголовок immutable для /assets/* разрешал кэшировать эту подмену на год. Честный 404 отличает «файла нет» от «сеть лежит» и ничего не кэширует; guard vite:preloadError срабатывает и на нём.",
      "source": "/:path((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
